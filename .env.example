# Get a free API key from https://www.themoviedb.org/settings/api
# Either TMDB_API_KEY (v3) or TMDB_READ_TOKEN (v4 Bearer token) works.
TMDB_API_KEY=
TMDB_READ_TOKEN=

# Optional: limit results by region (ISO 3166-1, e.g. US, GB, CA, AU)
TMDB_REGION=US

# Optional: Streaming Availability API via RapidAPI. When set, the app
# supplements TMDB discovery with Movie of the Night's per-provider
# "upcoming additions" feed, which usually closes the gap against each
# service's own "coming soon" page.
# Get a key at: https://rapidapi.com/movie-of-the-night-movie-of-the-night-default/api/streaming-availability
STREAMING_AVAILABILITY_API_KEY=

# Optional: Watchmode API. When set, the app also pulls from Watchmode's
# /releases/ endpoint, which returns upcoming streaming releases per
# service with TMDB ids and actual streamer release dates. Free tier is
# 1,000 requests/month and we make ~1 call per 24h cache window, so a
# single key is plenty for a personal deployment.
# Get a key at: https://api.watchmode.com/
WATCHMODE_API_KEY=
